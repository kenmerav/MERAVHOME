{
  "manifest_version": 3,
  "name": "Send to MERAV Studio",
  "description": "Send product pages and product images directly to MERAV Studio.",
  "version": "0.1.3",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications"],
  "host_permissions": ["https://studio.meravinteriors.com/*", "https://*.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to MERAV Studio",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://studio.meravinteriors.com/*", "https://*.vercel.app/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
